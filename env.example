# Настройки тренажёра 112 / ДДС.
# Скопируйте в .env:  cp .env.example .env
# Здесь перечислены только переменные, которые реально читают docker-compose.yml и Makefile.
# Если строку удалить, используется значение по умолчанию, указанное справа от неё.
# Подробности: docs/DEPLOYMENT.md, раздел 4.

# ---- База данных (PostgreSQL) ----
# Смените ДО первого запуска: пароль записывается в state/pg при инициализации.
# Если сменить его позже, приложение не подключится к базе.
DB_PASSWORD=change_me_please

# ---- Доступ к приложению ----
# 127.0.0.1 — только с самого сервера (по умолчанию; вход через SSH-туннель).
# 0.0.0.0   — доступ из сети. Микрофон в браузере при этом работает только по HTTPS.
BIND_HOST=127.0.0.1
# Порт приложения на хосте. Makefile использует его для make health и make tunnel.
PORT=8080

# ---- Учётные записи первого запуска ----
# Пусто — стандартные пароли admin112 / teacher112 / trainee112 (только для демонстрации).
# Действуют только при пустой базе; позже пароли меняются в интерфейсе.
ADMIN_PASSWORD=
TEACHER_PASSWORD=
TRAINEE_PASSWORD=

# ---- Языковая модель (OpenAI-совместимый API, обычно vLLM) ----
# По умолчанию — модель на хосте, порт 1212. make up-llm сам подставит адрес контейнера.
LLM_BASE_URL=http://host.docker.internal:1212/v1
# Должно совпадать с --served-model-name у vLLM (проверка: curl localhost:1212/v1/models).
LLM_MODEL=Qwen3-VL
# false — без модели: заявитель отвечает по правилам, оценка не меняется.
LLM_ENABLED=true

# ---- Распознавание речи ----
# auto — GigaAM на GPU, при сбое Vosk на CPU; gigaam — только GigaAM; vosk — только Vosk.
ASR_ENGINE=auto
# Номер видеокарты для GigaAM. Лучше не та, на которой работает модель (см. nvidia-smi).
ASR_GPU=1

# ---- Синтез речи F5-TTS (контейнер t112-f5, профиль gpu) ----
# Веса, звуки и голоса в репозиторий не входят: укажите, где они лежат на сервере.
# Если F5 недоступен, сервис voice синтезирует через Piper.
F5_GPU=1
F5_NFE_STEP=12
F5_URL=http://tts:8092
F5_MODEL_DIR=/data/models/F5-TTS_RUSSIAN
F5_HF_HOME=/data/models
F5_SOUND_DIR=/data/112/voice/Sound
F5_VOICES_DIR=/data/112/voice/Voices

# ---- Учебные параметры ----
# Учебный тайминг по ТЗ, секунды. Администратор может изменить его в интерфейсе.
UCHEBNY_TAYMING_SEC=30
# Режим ДДС: через сколько секунд после выезда бригада прибывает, начинает и завершает работы.
DDS_ETAPY_SEC=45,25,50

# ---- Резервные копии ----
# Период автоматического копирования базы, секунды (86400 — раз в сутки; хранятся 14 копий).
BACKUP_PERIOD_SEC=86400

# ---- Модель в контейнере (только make up-llm) ----
# Если модель уже работает на хосте, этот блок не нужен.
LLM_HF_MODEL=Qwen/Qwen3-VL-8B-Instruct
LLM_GPU=0
LLM_GPU_UTIL=0.85
LLM_MAX_LEN=8192
LLM_PORT=1212
# Зафиксируйте конкретную версию образа, если latest не стартует.
VLLM_IMAGE=vllm/vllm-openai:latest
# Кэш весов на хосте и токен Hugging Face (нужен только для закрытых моделей).
HF_CACHE=./state/hf
HF_TOKEN=
