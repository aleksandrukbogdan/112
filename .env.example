# ---- Postgres ----
PG_USER=t112
PG_PASSWORD=change_me_please
PG_DB=trainer112

# ---- LLM (разворачивается ОТДЕЛЬНО, в этот compose не входит) ----
# Имя модели — это --served-model-name, а не путь к весам.
LLM_BASE_URL=http://host.docker.internal:1212/v1
LLM_MODEL=Qwen3-VL
LLM_ENABLED=true

# ---- Речевые модели ----
# На старте можно выключить обе: текстовый режим работает и без них.
ASR_ENABLED=true
TTS_ENABLED=true
GIGAAM_MODEL=v3_e2e_rnnt
SILERO_MODEL_FILE=v4_ru.pt
SILERO_SPEAKER=xenia

# ---- GPU ----
# 0 занята LLM. Речевые модели на 1.
SPEECH_GPU=1

# ---- Доступ ----
# 127.0.0.1 — только с самого сервера (безопасно, по умолчанию).
# 0.0.0.0    — доступ с других машин в сети.
# ВНИМАНИЕ: при 0.0.0.0 микрофон в браузере НЕ заработает — браузеры дают
# доступ к нему только на localhost или по https. Подробности в README.
BIND_HOST=127.0.0.1

# ---- Порты на хосте ----
# Блок 21120-21125 выбран намеренно: он ниже эфемерного диапазона Linux
# (тот начинается с 32768) и не пересекается с привычными 3000/5432/6379/8080,
# которые почти всегда уже кем-то заняты.
# Проверить перед стартом: make ports
WEB_PORT=21120
API_PORT=21121
PG_PORT=21122
REDIS_PORT=21123
ASR_PORT=21124
TTS_PORT=21125

# ---- Фронт ----
# Браузер ходит в API напрямую, поэтому здесь адрес, который видит БРАУЗЕР.
# Меняете API_PORT — обязательно меняйте и эту строку.
# Для доступа с других машин: http://IP-СЕРВЕРА:21121
NEXT_PUBLIC_API_URL=http://localhost:21121
