         try:
             cur = c.execute(_sql(sql), tuple(args))
             r = _rows(cur)
-            if PG:
+            if PG and not getattr(_transaction, "depth", 0):
                 c.commit()
             return r
         except Exception:
-            if PG:
+            if PG and not getattr(_transaction, "depth", 0):
                 c.rollback()
             raise
 
@@ -148,10 +167,12 @@ def ex(sql: str, args=()):
             else:
                 cur = c.execute(s, tuple(args))
